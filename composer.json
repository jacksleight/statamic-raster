{
    "name": "jacksleight/statamic-raster",
    "autoload": {
        "psr-4": {
            "JackSleight\\StatamicRaster\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Raster",
            "description": "Rasterise views and partials to images by simply adding a tag and fetching the URL."
        },
        "laravel": {
            "providers": [
                "JackSleight\\StatamicRaster\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0|^6.0",
        "jacksleight/laravel-raster": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
